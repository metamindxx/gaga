{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strictNullChecks": true,
    "allowArbitraryExtensions": true,
    "types": ["svelte", "three"],
    "plugins": [{ "name": "typescript-svelte-plugin" }],
    "lib": ["ES2017", "DOM"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.d.ts",
    "vite.config.ts",
    "svelte.config.js"
  ],
  "exclude": ["node_modules", "docs", "public", "dist", "build"]
}

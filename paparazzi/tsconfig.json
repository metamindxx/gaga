{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strictNullChecks": true,
    "allowArbitraryExtensions": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "types": ["svelte", "three"],
    "plugins": [{ "name": "typescript-svelte-plugin" }],
    "target": "ES6",
    "lib": ["ES2017", "DOM"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.d.ts",
    "vite.config.ts",
    "svelte.config.js",
    "src/geometry/Circle.svelte",
    "src/geometry/Sphere.svelte",
    "src/geometry/Point.svelte"
  ],
  "exclude": ["node_modules", "docs", "public", "dist"]
}
